# ==============================================================================
# NAGARA AI - Environment Variables Configuration Template
# Concepts: Environment variables & secrets management
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Security & Authentication Secrets
JWT_SECRET=nagara_ai_super_secret_jwt_key_development_2026
JWT_EXPIRY_HOURS=24
BCRYPT_SALT_ROUNDS=10

# PostgreSQL Relational Database (Prisma ORM)
DATABASE_URL=postgresql://nagara_admin:nagara_secure_pass@localhost:5432/nagara_db?schema=public

# MongoDB NoSQL Telemetry Database (Mongoose)
MONGODB_URI=mongodb://localhost:27017/nagara_telemetry

# Redis Caching Layer
REDIS_URL=redis://localhost:6379
REDIS_DEFAULT_TTL_SEC=300

# AI Provider Credentials (AWS Bedrock / OpenAI / Gemini)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-mock-key-for-development-and-viva-evaluation
AWS_REGION=ap-south-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# 3rd-Party APIs
OPENWEATHER_API_KEY=mock_openweather_api_key
RAZORPAY_KEY_ID=rzp_test_mock_key_id
RAZORPAY_KEY_SECRET=rzp_test_mock_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
